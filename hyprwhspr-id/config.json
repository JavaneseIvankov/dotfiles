{
  "$schema": "https://raw.githubusercontent.com/goodroot/hyprwhspr/main/share/config.schema.json",
  "transcription_backend": "rest-api",
  "rest_endpoint_url": "https://api.groq.com/openai/v1/audio/transcriptions",
  "rest_api_provider": "groq",
  "rest_body": {
    "model": "whisper-large-v3-turbo"
  },
  "language": null,
  "whisper_prompt": "Transkripsi percakapan campuran Bahasa Indonesia dan English (code-switching). Pertahankan istilah teknis, nama produk, dan kata bahasa Inggris apa adanya.",
  "recording_mode": "auto",
  "primary_shortcut": "Super+Space",
  "cancel_shortcut": "Escape",
  "keyboard_device_names": [
    "kanata"
  ]
}
