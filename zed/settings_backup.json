// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// Zed Clean & Minimal Settings
{
   "language_models": {
      "openai_compatible": {
         "9router": {
            "api_url": "http://localhost:20128/api/v1",
            "available_models": [
               {
                  "name": "cheap",
                  "max_tokens": 200000,
                  "max_output_tokens": 32000,
                  "max_completion_tokens": 200000,
                  "reasoning_effort": "medium",
                  "capabilities": {
                     "tools": true,
                     "images": false,
                     "parallel_tool_calls": false,
                     "prompt_cache_key": false,
                     "chat_completions": true,
                     "interleaved_reasoning": false,
                     "max_tokens_parameter": false,
                  },
               },
               {
                  "name": "smart",
                  "max_tokens": 200000,
                  "max_output_tokens": 32000,
                  "max_completion_tokens": 200000,
                  "reasoning_effort": "medium",
                  "capabilities": {
                     "tools": true,
                     "images": false,
                     "parallel_tool_calls": false,
                     "prompt_cache_key": false,
                     "chat_completions": true,
                     "interleaved_reasoning": false,
                     "max_tokens_parameter": false,
                  },
               },
               {
                  "name": "balance",
                  "max_tokens": 200000,
                  "max_output_tokens": 32000,
                  "max_completion_tokens": 200000,
                  "reasoning_effort": "medium",
                  "capabilities": {
                     "tools": true,
                     "images": true,
                     "parallel_tool_calls": true,
                     "prompt_cache_key": false,
                     "chat_completions": true,
                     "interleaved_reasoning": false,
                     "max_tokens_parameter": false,
                  },
               },
            ],
         },
      },
   },
   "edit_predictions": {
      "allow_data_collection": "no",
   },
   "agent_servers": {
      "pi-acp": {
         "default_config_options": {
            "thought_level": "off",
         },
         "type": "registry",
      },
      "codex-acp": {
         "type": "registry",
         "default_config_options": {
            "reasoning_effort": "low",
            "model": "gpt-5.4-mini",
         },
      },
   },
   "cli_default_open_behavior": "new_window",
   "terminal": {
      "font_size": 18.0,
      "font_family": "JetBrainsMono Nerd Font Mono",
      "blinking": "off",
   },
   "git": {
      "inline_blame": {
         "enabled": true,
      },
   },
   "preview_tabs": {
      "enabled": false,
   },
   "multi_cursor_modifier": "cmd_or_ctrl",
   "sticky_scroll": {
      "enabled": false,
   },
   "vertical_scroll_margin": 6.0,
   "gutter": {
      "line_numbers": true,
   },
   "scrollbar": {
      "axes": {
         "horizontal": false,
         "vertical": false,
      },
   },
   "hover_popover_sticky": false,
   "rounded_selection": false,
   "cursor_blink": true,
   "autosave": {
      "after_delay": {
         "milliseconds": 1500,
      },
   },
   "file_types": {
      "plaintext": ["*.kdl"],
      "php": ["*.module"],
      "python": ["*.ipynb"],
   },
   "colorize_brackets": true,
   "show_whitespaces": "selection",
   "wrap_guides": [],
   "tab_size": 3,
   "agent": {
      "play_sound_when_agent_done": "when_hidden",
      "single_file_review": true,
      "default_profile": "write",
      "model_parameters": [],
      "default_model": {
         "effort": "medium",
         "enable_thinking": true,
         "provider": "9router",
         "model": "cheap",
      },
   },
   "icon_theme": "Bearded Icon Theme",
   "base_keymap": "VSCode",

   // Editor UI
   "vim_mode": true,
   "ui_font_size": 16,
   "ui_font_family": "Hack Nerd Font",

   // "buffer_font_family": "JetBrainsMono Nerd Font",
   "buffer_font_family": "JetBrains Mono NL Slashed",
   "buffer_font_size": 20.0,
   // "buffer_font_weight": 500,

   // Disable tracking
   "telemetry": {
      "metrics": false,
   },

   // Theme customization
   "theme": {
      "mode": "dark",
      "light": "Gruvbox Dark Hard",
      "dark": "Ayu Dark",
   },

   // Clean look
   "editor": {
      "highlight_active_line": false,
      "scroll_past_end": false,
      "render_whitespace": false,
   },

   "indent_guides": {
      "active_line_width": 2,
   },

   "relative_line_numbers": "enabled",
   "line_indicator_format": "short",

   "breadcrumbs": false, // hides file path bar
   "minimap": {
      "show": "never",
   }, // disable minimap

   // Optional: reduce distractions
   "notifications": {
      "show_toasts": false,
   },

   // Control which items are shown/hidden in the title bar
   "title_bar": {
      "show_branch_icon": true, // Show/hide branch icon beside branch switcher
      "show_branch_name": true, // Show/hide branch name
      "show_project_items": true, // Show/hide project host and name
      "show_onboarding_banner": false, // Show/hide onboarding banners
      "show_user_picture": true, // Show/hide user avatar
      "show_sign_in": false, // Show/hide sign-in button
      "show_menus": false, // Show/hide menus
   },

   "project_panel": {
      "dock": "right",
      "scrollbar": {
         "show": "never",
      },
      "indent_guides": {
         "show": "never",
      },
   },

   // Optional: hide tab bar if only one file open
   "tabs": {
      "show_single_tab": false,
   },

   "max_tabs": 3,

   "tab_bar": {
      "show": true,
      "show_nav_history_buttons": false,
   },

   "toolbar": {
      "breadcrumbs": false,
      "quick_actions": false,
   },

   "features": {
      "edit_prediction_provider": "copilot",
   },

   "diagnostics": {
      "button": true,
      "include_warnings": true,
      "inline": {
         "enabled": true,
         "update_debounce_ms": 150,
         "padding": 4,
         "min_column": 0,
         "max_severity": "error",
      },
      "cargo": null,
   },

   "file_finder": {
      "skip_focus_for_active_in_search": true,
   },
}
