;; Kanata Configuration (SSOT Keymap Implementation)
;; https://github.com/jtroo/kanata

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "Telink Wireless Device"
  )
)

(defsrc
  caps esc  lmet lalt spc  ralt c lsft
  h j k l
  u o p s
  w b
  v
)

(deflayer base
  @cap caps ralt @l-sft spc @r-lmet c lsft
  h j k l
  u o p s
  w b
  v
)

(deflayer nav
  _    _    _    _      _   _    _    _
  left down up   right
  C-z  bspc C-bspc _
  C-right C-left
  _
)

(deflayer lalt-layer
  _    _    _    _      @th-ret (layer-while-held dual-thumb) _ _
  _    _    _    _
  _    _    _    _
  _    _
  _
)

(deflayer ralt-layer
  _    _    _    (layer-while-held dual-thumb) _ _ @c-esc _
  _    _    _    _
  _    @o-act @p-act _
  _    _
  @v-act
)

(deflayer dual-thumb
  _    _    _    _      _   _    _    _
  _    _    _    _
  C-z  bspc C-bspc M-ret
  _    _
  _
)

(defalias
  cap (tap-hold-release 200 200 esc (layer-while-held nav))
  l-sft (multi rshift (layer-while-held lalt-layer))
  r-lmet (multi lmet (layer-while-held ralt-layer))
  o-act (fork (multi (release-key lmet) bspc) o (lsft))
  p-act (fork (multi (release-key lmet) C-bspc) p (lsft))
  c-esc (multi (release-key lmet) esc)

  ;; NIRIMAP: $MOD + v (hold) / $MOD + Shift + v (toggle).
  ;; niri has no key-release bindings, so the press passes through as v (niri
  ;; binds $MOD+v / $MOD+Shift+v) and the release emits fake key Pause, which
  ;; niri binds as $MOD+Pause -> hold-end. Pause carries the release instead of
  ;; a letter so no letter is ever synthesised, and niri's bare Print (screenshot)
  ;; stays untouched.
  v-act (multi (on-release-fakekey nm-holdend tap) v)

  ;; Simple, repeatable Thumb Enter: unshift lalu kirim normal Enter
  th-ret (unshift ret)
)

(defvirtualkeys
  nm-holdend pause
)

(defchordsv2
  ;; TAHAN KEDUA JEMPOL (lalt + ralt) -> Masuk ke layer dual-thumb mandiri
  (lalt ralt) (layer-while-held dual-thumb) 200 first-release ()

  ;; ESCAPE KANAN: Tahan ralt + c -> Escape
  (ralt c) esc 200 first-release ()

  ;; HOME-ROW CHORD JK -> Escape instan saat mengetik teks normal di base layer
  (j k) esc 45 first-release (nav ralt-layer dual-thumb)
)
