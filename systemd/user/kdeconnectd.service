[Unit]
Description=KDE Connect daemon
Documentation=https://userbase.kde.org/KDEConnect
# kdeconnectd serves org.kde.kdeconnect on the session bus and needs no display,
# so it starts at login and survives compositor restarts.
Requires=dbus.socket
After=dbus.socket

[Service]
Type=simple
# kdeconnectd is single-instance: a second copy exits 0 once another one owns
# org.kde.kdeconnect. Skip the start instead of racing D-Bus activation.
ExecCondition=/bin/sh -c '! pgrep -x kdeconnectd'
ExecStart=/usr/bin/kdeconnectd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
